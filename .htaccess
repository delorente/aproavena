# Aproavena · Apache

# --- Página por defecto ------------------------------------------------------
DirectoryIndex index.php index.html

# --- Forzar HTTPS ------------------------------------------------------------
# Sin esto, entrar por http:// deja pasar el login del panel en texto plano
# y la cookie de sesion no se marca como secure.
# La segunda condicion cubre el caso de estar detras de un proxy inverso.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  # El entorno local no tiene certificado: sin estas dos lineas, WAMP
  # redirige a un https://localhost que no responde.
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- No listar directorios ---------------------------------------------------
Options -Indexes

# --- Archivos que nunca deben servirse por HTTP ------------------------------
<FilesMatch "\.(sql|md|json|lock|example\.php)$">
  Require all denied
</FilesMatch>

# El creador de usuarios es solo de consola; igual se bloquea por si acaso.
<Files "crear-usuario.php">
  Require all denied
</Files>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Cabeceras de seguridad --------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: el navegador usa HTTPS aunque el usuario escriba http://.
  # Sin includeSubDomains a proposito: exigirlo romperia cualquier
  # subdominio que no tenga certificado propio.
  # Los navegadores lo ignoran cuando llega por HTTP, asi que es inocuo ahi.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# --- Caché de estáticos ------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType image/jpeg              "access plus 30 days"
  ExpiresByType image/png               "access plus 30 days"
  ExpiresByType image/webp              "access plus 30 days"
  ExpiresByType application/pdf         "access plus 7 days"
</IfModule>

# --- Compresión --------------------------------------------------------------
# application/json es lo que sirve el endpoint de datos de los graficos: son
# megabytes de texto muy repetitivo, es donde mas se nota.
# Los .xlsx no van aqui: ya son un zip, comprimirlos otra vez solo gasta CPU.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>
